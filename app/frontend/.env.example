# Base path the browser uses for API requests. The default ("/api") is proxied
# to the backend by the Vite dev server, so no CORS setup is needed in dev.
# Set an absolute URL (e.g. https://api.example.com) when the API lives on
# another origin.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards "/api" requests. Defaults to the backend
# PORT from app/backend/.env.
VITE_API_PROXY_TARGET=http://localhost:3000
