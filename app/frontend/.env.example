# Base URL the browser uses for API requests.
# Leave unset to use the defaults: in development the app calls
# http://localhost:3000 directly (the backend must allow
# http://localhost:5173 through its CORS_ORIGINS setting), and in production
# it calls the same-origin "/api" path.
# Set an absolute URL (e.g. https://api.example.com) to override.
VITE_API_BASE_URL=http://localhost:3000
