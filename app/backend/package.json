{
  "name": "@ecommerce/backend",
  "version": "1.0.0",
  "description": "Express backend for the ecommerce app",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/src/index.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "cross-env NODE_ENV=development tsx src/scripts/seed-admin.ts",
    "seed:admin:prod": "cross-env NODE_ENV=production tsx src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@ecommerce/schemas": "^1.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-zod-safe": "^3.2.1",
    "jose": "^6.2.12",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
