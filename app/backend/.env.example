# Copy this file to `.env.development` (used by `npm run dev`) and `.env.test`
# (used by `npm test`). `NODE_ENV` is set by the npm scripts via cross-env, so
# it is intentionally not set here.
PORT=3000

# Comma-separated browser origins allowed to call the API cross-origin.
# Development and tests default to http://localhost:5173 and
# http://127.0.0.1:5173 and accept any localhost port (Vite falls back to
# 5174/5175 when 5173 is taken). Production defaults to no cross-origin
# access, which is correct when the SPA and API share an origin behind a
# reverse proxy. Set this when they are served from different origins, e.g.
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com
CORS_ORIGINS=

# Postgres connection string. Required when NODE_ENV=production.
# Use the Supabase "Session pooler" URI (Dashboard -> Connect), not the direct
# `db.<ref>.supabase.co` host: the direct host is IPv6-only and fails on many
# networks. The session pooler keeps a stable session, so migrations and
# prepared statements both work.
#
# - `uselibpqcompat=true` is required by pg 8.23+, which otherwise treats
#   `sslmode=require` as `verify-full` and rejects Supabase's certificate chain.
#   Alternatively drop `uselibpqcompat` and pin the project CA with
#   `sslmode=verify-full&sslrootcert=<path>`.
# - Replace <region>, <ref> and the password with the values from the dashboard.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Max pool connections. Keep it below the project's pooler client limit.
DB_POOL_MAX=10

# Access token signing secret. Required in every environment (the app refuses
# to boot without it) and must be at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Bootstrap admin account, created by `npm run seed:admin` (use
# `seed:admin:prod` for production, which loads `.env.production`). Re-running
# the seed resets this user's password and role. Required when NODE_ENV=production.
# The password must satisfy the shared password policy (8-64 chars, upper, lower, digit, special).
ADMIN_EMAIL=admin@ecommerce.test
ADMIN_PASSWORD=ChangeMe1234!

# Tests load `.env.test` and use its DATABASE_URL. Point that at a dedicated
# test database (a second Supabase project, same session-pooler format, or a
# local Postgres when working offline): the suite truncates every table, and
# `tests/test-db.ts` refuses to run when it matches `.env.development`.

# Stripe. Get these from https://dashboard.stripe.com/apikeys.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are required when NODE_ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Where Stripe Checkout redirects the customer after the session.
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# Supabase Storage for product images.
# Use the secret key (service role) on the server; it bypasses bucket RLS.
# The bucket must exist and be public so the stored public URLs are readable.
# SUPABASE_URL and SUPABASE_SECRET_KEY are required when NODE_ENV=production.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
